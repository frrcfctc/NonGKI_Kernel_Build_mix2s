CONFIG_ENV=Profiles/jason_crdroid.env

DEVICE_NAME=Xiaomi_MiNote3_CN
DEVICE_CODENAME=jason

CUSTOM_CMDS=
EXTRA_CMDS=

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_sdm660
KERNEL_BRANCH=lineage-19.1
CLANG_SOURCE=https://github.com/kdrag0n/proton-clang
CLANG_BRANCH=master

GCC_GNU=false
GCC_64_SOURCE=
GCC_64_BRANCH=
GCC_32_SOURCE=https://android.googlesource.com/platform/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9
GCC_32_BRANCH=android-12.1.0_r27

DEFCONFIG_SOURCE=
DEFCONFIG_NAME=sdm660-perf_defconfig
DEFCONFIG_ORIGIN_IMAGE=

KERNELSU_SOURCE=https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-Ultra/main/kernel/setup.sh
KERNELSU_BRANCH=main
KERNELSU_NAME=SukiSU-Ultra

SUSFS_ENABLE=true
SUSFS_FIXED=true

AK3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
AK3_BRANCH=master

BOOT_SOURCE=

LXC_ENABLE=false

HAVE_NO_DTBO=false
HAVE_NO_DTBO_TOOL=false

ROM_TEXT=crDroid_Android11
